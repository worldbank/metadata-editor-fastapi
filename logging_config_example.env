# Metadata Editor FastAPI - Logging Configuration Example
# Copy these variables to your .env file to configure logging

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: ERROR (only shows errors, clean output)
LOG_LEVEL=ERROR

# Log format: simple, detailed, timestamp, minimal
# All formats except minimal include a timestamp on each line.
# - simple: "2025-08-22 12:27:31 - ERROR - message"
# - detailed: "2025-08-22 12:27:31 - module - ERROR - function:line - message"
# - timestamp: "2025-08-22 12:27:31 - ERROR - message"
# - minimal: "ERROR: message"
# Default: timestamp
LOG_FORMAT=timestamp

# Enable logging to file (true/false)
# Default: true (writes to logs/app.log, rotated daily at midnight)
LOG_TO_FILE=true

# Log file path (only used if LOG_TO_FILE=true)
# Default: logs/app.log (rotated to logs/app.log.YYYY-MM-DD)
# LOG_FILE_PATH=logs/app.log

# Number of daily log files to retain (default: 30)
# LOG_RETENTION_DAYS=30

# Durable FIFO job audit log (JSON lines, flushed on each event)
# JOB_AUDIT_LOG_DIR=logs
# JOB_AUDIT_LOG_FILE=job_audit.log

# SQLite job store for queue persistence across restarts
# JOB_STORE_DB_PATH=db/jobs.sqlite

# ============================================================================
# CSV EXPORT MEMORY OPTIMIZATION
# ============================================================================

# Minimum CSV file size (bytes) before using optimized dtype loading.
# Files below this threshold use the legacy loader (same behavior as before).
# Set to 0 to disable optimized loading entirely.
# Default: 524288000 (500 MB) — tuned for servers with at least 16 GB RAM
# CSV_EXPORT_OPTIMIZE_MIN_BYTES=524288000

# Rows to sample when inferring CSV dtypes for large files.
# CSV_EXPORT_SAMPLE_ROWS=10000

# Max unique values for a string column to be loaded as category dtype.
# CSV_EXPORT_CATEGORY_MAX_CARDINALITY=256

# ============================================================================
# LOGGING EXAMPLES
# ============================================================================

# Example 1: Production (errors only, file + console)
# LOG_LEVEL=ERROR
# LOG_FORMAT=timestamp
# LOG_TO_FILE=true

# Example 2: Development (detailed debugging)
# LOG_LEVEL=DEBUG
# LOG_FORMAT=detailed
# LOG_TO_FILE=true

# Example 3: Console only (no file)
# LOG_LEVEL=INFO
# LOG_FORMAT=timestamp
# LOG_TO_FILE=false

# Example 4: Minimal console output
# LOG_LEVEL=WARNING
# LOG_FORMAT=minimal
# LOG_TO_FILE=false
