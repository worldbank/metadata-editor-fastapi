# Metadata Editor FastAPI - Logging Configuration Example
# Copy these variables to your .env file to configure logging

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: ERROR (only shows errors, clean output)
LOG_LEVEL=ERROR

# Log format: simple, detailed, timestamp, minimal
# All formats except minimal include a timestamp on each line.
# - simple: "2025-08-22 12:27:31 - ERROR - message"
# - detailed: "2025-08-22 12:27:31 - module - ERROR - function:line - message"
# - timestamp: "2025-08-22 12:27:31 - ERROR - message"
# - minimal: "ERROR: message"
# Default: timestamp
LOG_FORMAT=timestamp

# Enable logging to file (true/false)
# Default: true (writes to logs/app.log, rotated daily at midnight)
LOG_TO_FILE=true

# Log file path (only used if LOG_TO_FILE=true)
# Default: logs/app.log (rotated to logs/app.log.YYYY-MM-DD)
# LOG_FILE_PATH=logs/app.log

# Number of daily log files to retain (default: 30)
# LOG_RETENTION_DAYS=30

# ============================================================================
# LOGGING EXAMPLES
# ============================================================================

# Example 1: Production (errors only, file + console)
# LOG_LEVEL=ERROR
# LOG_FORMAT=timestamp
# LOG_TO_FILE=true

# Example 2: Development (detailed debugging)
# LOG_LEVEL=DEBUG
# LOG_FORMAT=detailed
# LOG_TO_FILE=true

# Example 3: Console only (no file)
# LOG_LEVEL=INFO
# LOG_FORMAT=timestamp
# LOG_TO_FILE=false

# Example 4: Minimal console output
# LOG_LEVEL=WARNING
# LOG_FORMAT=minimal
# LOG_TO_FILE=false
