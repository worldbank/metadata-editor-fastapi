# This file contains environment variables for the application.
# Make a copy of this file and rename it to .env before using it.

# ---------------------------------------------------------------------------
# STORAGE_PATH (required — choose one)
# ---------------------------------------------------------------------------
# Absolute path to the metadata editor data folder (recommended for production):
STORAGE_PATH=/path/to/metadata-editor/datafiles
#
# Or disable path validation for local development only:
# STORAGE_PATH=

# ---------------------------------------------------------------------------
# Server (defaults match start.sh / start.bat)
# ---------------------------------------------------------------------------
# Bind to localhost only. Do not expose this service to untrusted networks.
HOST=127.0.0.1
PORT=8000
