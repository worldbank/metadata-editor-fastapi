# =============================================================================
# Metadata reviewer — copy to `reviewer.env` next to `main.py` (gitignored).
# Prefer REVIEWER_* names here. Legacy unprefixed names (AZURE_OPENAI_*,
# OPENAI_API_KEY, etc.) in `.env` still
# work as fallbacks if a REVIEWER_* key is not set.
# =============================================================================

# --- Provider (openai | azure | ollama | anthropic) ---
REVIEWER_PROVIDER=azure
REVIEWER_MODEL=gpt-4o

# Concurrency (main.py / review router)
REVIEWER_CONCURRENCY=10
REVIEWER_MAX_INFLIGHT=200
REVIEWER_JOB_TIMEOUT_SEC=900

# =============================================================================
# Azure OpenAI (when REVIEWER_PROVIDER=azure)
# =============================================================================
REVIEWER_AZURE_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
REVIEWER_AZURE_DEPLOYMENT=your-deployment-name
REVIEWER_AZURE_API_VERSION=2024-02-01

# --- Auth: choose ONE approach ---

# (A) API key (Azure portal “Keys and Endpoint”)
# REVIEWER_AZURE_API_KEY=

# (B) Entra ID — client credentials (service principal)
# REVIEWER_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# REVIEWER_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# REVIEWER_AZURE_CLIENT_SECRET=replace-with-secret-from-app-registration

# Scope for get_bearer_token_provider / ClientSecretCredential
# Common: https://cognitiveservices.azure.com/.default
# Or resource app-id form if your tenant requires it:
# REVIEWER_AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# =============================================================================
# OpenAI (when REVIEWER_PROVIDER=openai)
# =============================================================================
# REVIEWER_OPENAI_API_KEY=

# =============================================================================
# Anthropic (when REVIEWER_PROVIDER=anthropic)
# =============================================================================
# REVIEWER_ANTHROPIC_API_KEY=

# =============================================================================
# Ollama (when REVIEWER_PROVIDER=ollama)
# =============================================================================
# REVIEWER_OLLAMA_PORT=11434
