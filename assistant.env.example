# =============================================================================
# Assistant: copy to `assistant.env` next to `main.py` (gitignored).
# Models are declared in assistant.models.yaml (copy assistant.models.yaml.example).
# =============================================================================

# The service runs on the same server as the editor (deploy/linux or deploy/windows). The help text and
# the documentation the assistant searches live in the editor's folder; point at them there. Replace
# /var/www/metadata-editor with the editor's folder (Windows: C:/inetpub/wwwroot/metadata-editor).
# STORAGE_PATH in .env must be the editor's data folder (it already is for data jobs): the assistant
# reads project files only under it. Then set server_assistant_enabled to true in the editor's
# application/config/editor.php.

# Set to 0 to keep the /assistant routes unmounted even when LiteLLM is installed.
ASSISTANT_ENABLED=1

ASSISTANT_MODELS_PATH=assistant.models.yaml
# Help text the assistant is grounded in (the editor's assistant-help.md). Empty = none.
ASSISTANT_HELP_PATH=/var/www/metadata-editor/assistant-help.md

# Documentation the assistant searches (BM25 + local embeddings): path=label;path=label
# Paths are relative to this directory or absolute. Empty = no document retrieval. Generate the files
# with `node tools/assistant-docs.mjs` in the editor.
ASSISTANT_DOCS=/var/www/metadata-editor/assistant-docs/usage.md=editor usage guide;/var/www/metadata-editor/assistant-docs/schema-guide.md=DDI schema guide;/var/www/metadata-editor/assistant-docs/api.md=editor API reference

# Networks that re-sign TLS (a corporate proxy) need their CA bundle for hosted models and the one-time
# embedding model download. Python ships its own CA list and ignores the system's, so this is needed even
# when curl works. On Linux, add the corporate CA to the system (Debian/Ubuntu: copy it to
# /usr/local/share/ca-certificates/*.crt and run update-ca-certificates) and point both at the system
# bundle. On Windows, export the corporate CA chain to a .pem file and point both at it.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Local embedding model: ultrabert-embed-150m (default) or none (keyword search only).
# Downloaded once (~605 MB, pinned revision, SHA-256 checked) into ASSISTANT_MODEL_CACHE.
ASSISTANT_EMBEDDER=ultrabert-embed-150m
ASSISTANT_MODEL_CACHE=db/models
ASSISTANT_INDEX_PATH=db/assistant_index.npz
# ASSISTANT_RETRIEVAL_TOP_K=5
# ASSISTANT_RETRIEVAL_MAX_BYTES=6144
# ASSISTANT_RETRIEVAL_CHUNK_CHARS=1200
# ASSISTANT_RETRIEVAL_ALPHA=0.5
# ASSISTANT_RETRIEVAL_MIN_SIMILARITY=     (empty = the embedder's measured floor)
# ASSISTANT_EMBEDDER_THREADS=0            (0 = ONNX Runtime default)

# Only offer models marked `local: true` (record data never leaves your infrastructure).
ASSISTANT_LOCAL_ONLY=0

# Base URL of the local model server, referenced from assistant.models.yaml. Unset = the default
# written in the registry (assistant.models.yaml.example: llama-server on :8080, Ollama on :11434).
#   Ollama:        http://127.0.0.1:11434
#   llama-server:  http://127.0.0.1:8080/v1
#   LM Studio:     http://127.0.0.1:1234/v1
# ASSISTANT_OLLAMA_BASE=http://127.0.0.1:11434
# ASSISTANT_LLAMA_BASE=http://127.0.0.1:8080/v1

# Hosted providers: a model whose key is unset is listed as unconfigured, not an error.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Limits
ASSISTANT_CONCURRENCY=4
ASSISTANT_MAX_INFLIGHT=32
ASSISTANT_MAX_HISTORY=6
ASSISTANT_CONTEXT_MAX_BYTES=16384
ASSISTANT_REQUEST_TIMEOUT_SEC=120
ASSISTANT_NUM_RETRIES=0
